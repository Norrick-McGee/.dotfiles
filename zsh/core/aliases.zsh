# Cross-platform core aliases
alias la='ls -a'
alias ll='ls -lh'
alias lla='ls -lha'
alias grep='grep --color=auto'

# Safe operations
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'

# Git shortcuts
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gd='git diff'

# Directory navigation
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# Platform-specific aliases should go in platform files
